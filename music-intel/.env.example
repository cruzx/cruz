# ============================
# 音乐情报雷达 · 配置文件
# 复制为 .env 并填写你的 key
# ============================

# 通用视觉模型设置，支持 OpenAI-compatible API。
VISION_API_KEY=
VISION_MODEL=gpt-5.4-mini
VISION_BASE_URL=https://api.openai.com/v1

# ── 图片存储模式 ──────────────────────────────
# 可选值: local（本地文件夹）或 supabase（云端）
STORAGE_MODE=local

# Supabase（STORAGE_MODE=supabase 时必填）
# 获取地址: https://supabase.com → 项目设置 → API
SUPABASE_URL=
SUPABASE_KEY=
# Supabase Storage 的 Bucket 名称（需提前在 Supabase 控制台创建，设为 public）
SUPABASE_BUCKET=design-images

# 产品/科技动向 RSS 源。格式：名称|URL，多个用英文逗号分隔。
TECH_FEEDS=爱范儿|https://www.ifanr.com/feed,少数派|https://sspai.com/feed,36氪|https://36kr.com/feed,cnBeta|https://www.cnbeta.com.tw/backend.php,IT之家|https://www.ithome.com/rss/,Solidot|https://www.solidot.org/index.rss,虎嗅|https://rss.huxiu.com/,钛媒体|https://www.tmtpost.com/rss.xml,Product Hunt|https://www.producthunt.com/feed,TechCrunch|https://techcrunch.com/feed/,The Verge|https://www.theverge.com/rss/index.xml

# 本地数据存储目录 (默认 ./data，可改为绝对路径)
DATA_DIR=./data

# 看板服务端口
PORT=8765

# 采集频率 (小时，默认每天一次)
COLLECT_INTERVAL_HOURS=24
